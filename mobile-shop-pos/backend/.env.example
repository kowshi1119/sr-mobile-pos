# =============================================================================
# S R Mobile POS — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to Git.
# =============================================================================


# 🗄️  DATABASE
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE

# 🔑  JWT Secret (min 32 chars)
JWT_SECRET=your_very_long_random_jwt_secret_here_min_32_chars

# Admin credentials: feed a unique password to scripts/hashPassword.js through stdin
ADMIN_EMAIL=admin@srmobile.lk
ADMIN_PASSWORD=$2a$10$GENERATED_HASH_HERE

# ☁️  Cloudinary - https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 📱  Meta WhatsApp Business API - https://developers.facebook.com
META_WHATSAPP_TOKEN=your_meta_permanent_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_BUSINESS_ID=your_waba_id
META_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verification_token

# 🤖  Groq AI - https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# 🌐  URLs
FRONTEND_URL=http://localhost:3000
PORT=5000
