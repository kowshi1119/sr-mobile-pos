// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id              String         @id @default(uuid())
  name            String
  phone           String         @unique
  whatsappNumber  String?
  whatsappOptIn   Boolean        @default(false)
  totalDebt       Decimal        @default(0) @db.Decimal(10, 2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  sales           Sale[]
  repairs         Repair[]
  notifications   Notification[]
  debtRecords     DebtRecord[]
  loyaltyAccount  LoyaltyAccount?
}

model Category {
  id              String     @id @default(uuid())
  name            String
  icon            String?
  warrantyMonths  Int        @default(3)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  products        Product[]
}

model Product {
  id                 String            @id @default(uuid())
  categoryId         String
  name               String
  sku                String            @unique
  barcode            String            @unique
  sellingPrice       Decimal           @db.Decimal(10, 2)
  costPrice          Decimal           @db.Decimal(10, 2)
  stockQuantity      Int               @default(0)
  lowStockThreshold  Int               @default(5)
  warrantyMonths     Int?
  imageUrl           String?
  isActive           Boolean           @default(true)
  hasImei            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  category           Category          @relation(fields: [categoryId], references: [id])
  variants           ProductVariant[]
  saleItems          SaleItem[]
  imeiRecords        ImeiRecord[]
  warrantyRecords    WarrantyRecord[]
  bundleItems        BundleItem[]
}

model ProductVariant {
  id             String    @id @default(uuid())
  productId      String
  variantName    String
  priceOverride  Decimal?  @db.Decimal(10, 2)
  stockQuantity  Int       @default(0)
  barcode        String    @unique
  createdAt      DateTime  @default(now())
  product        Product   @relation(fields: [productId], references: [id])
  saleItems      SaleItem[]
}

model ImeiRecord {
  id         String      @id @default(uuid())
  productId  String
  imei       String      @unique
  status     ImeiStatus  @default(IN_STOCK)
  saleId     String?
  createdAt  DateTime    @default(now())
  product    Product     @relation(fields: [productId], references: [id])
  sale       Sale?       @relation(fields: [saleId], references: [id])
  saleItems  SaleItem[]
}

model Sale {
  id              String           @id @default(uuid())
  customerId      String
  invoiceNumber   String           @unique
  totalAmount     Decimal          @db.Decimal(10, 2)
  discountAmount  Float            @default(0)
  discountType    String           @default("NONE")
  paymentMethod   PaymentMethod
  createdAt       DateTime         @default(now())
  customer        Customer         @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  warrantyRecords WarrantyRecord[]
  notifications   Notification[]
  imeiRecords     ImeiRecord[]
  debtRecords     DebtRecord[]
}

model SaleItem {
  id        String          @id @default(uuid())
  saleId    String
  productId String
  variantId String?
  imeiId    String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)
  sale      Sale            @relation(fields: [saleId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  imei      ImeiRecord?     @relation(fields: [imeiId], references: [id])
}

model WarrantyRecord {
  id             String   @id @default(uuid())
  saleId         String
  productId      String
  warrantyMonths Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  sale           Sale     @relation(fields: [saleId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
}

model Repair {
  id                 String        @id @default(uuid())
  customerId         String
  deviceName         String
  issueDescription   String
  status             RepairStatus  @default(RECEIVED)
  estimatedCost      Decimal?      @db.Decimal(10, 2)
  actualCost         Decimal?      @db.Decimal(10, 2)
  collectedAt        DateTime      @default(now())
  promisedAt         DateTime?
  deliveredAt        DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  customer           Customer      @relation(fields: [customerId], references: [id])
  notifications      Notification[]
}

model Notification {
  id                String             @id @default(uuid())
  customerId        String
  saleId            String?
  repairId          String?
  channel           NotificationChannel @default(WHATSAPP)
  messageType       String
  templateName      String
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  customer          Customer           @relation(fields: [customerId], references: [id])
  sale              Sale?              @relation(fields: [saleId], references: [id])
  repair            Repair?            @relation(fields: [repairId], references: [id])
}

model AiChatSession {
  id              String   @id @default(uuid())
  query           String
  detectedIntent  String
  actionTaken     String
  createdAt       DateTime @default(now())
}

model InvoiceCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)
}

enum ImeiStatus {
  IN_STOCK
  SOLD
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum RepairStatus {
  RECEIVED
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model DebtRecord {
  id          String    @id @default(uuid())
  customerId  String
  saleId      String?
  type        DebtType
  amount      Decimal   @db.Decimal(10, 2)
  description String?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id])
  sale        Sale?     @relation(fields: [saleId], references: [id])
}

enum DebtType {
  CREDIT
  PAYMENT
}

model LoyaltyAccount {
  id            String               @id @default(uuid())
  customerId    String               @unique
  points        Int                  @default(0)
  totalEarned   Int                  @default(0)
  totalRedeemed Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  customer      Customer             @relation(fields: [customerId], references: [id])
  transactions  LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id          String         @id @default(uuid())
  accountId   String
  type        String
  points      Int
  description String?
  saleId      String?
  createdAt   DateTime       @default(now())
  account     LoyaltyAccount @relation(fields: [accountId], references: [id])
}

model Supplier {
  id        String             @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  purchases SupplierPurchase[]
}

model SupplierPurchase {
  id          String                 @id @default(uuid())
  supplierId  String
  invoiceRef  String?
  totalAmount Float                  @default(0)
  notes       String?
  purchasedAt DateTime               @default(now())
  createdAt   DateTime               @default(now())
  supplier    Supplier               @relation(fields: [supplierId], references: [id])
  items       SupplierPurchaseItem[]
}

model SupplierPurchaseItem {
  id          String           @id @default(uuid())
  purchaseId  String
  productId   String?
  productName String
  quantity    Float
  unitCost    Float
  totalCost   Float
  purchase    SupplierPurchase @relation(fields: [purchaseId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  category    String
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model SalesTarget {
  id           String   @id @default(uuid())
  year         Int
  month        Int
  targetAmount Float
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([year, month])
}

model Bundle {
  id          String       @id @default(uuid())
  name        String
  description String?
  bundlePrice Float
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  items       BundleItem[]
}

model BundleItem {
  id        String  @id @default(uuid())
  bundleId  String
  productId String
  quantity  Int     @default(1)
  bundle    Bundle  @relation(fields: [bundleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model OfflineSale {
  id        String   @id @default(uuid())
  localId   String   @unique
  payload   String
  synced    Boolean  @default(false)
  syncedAt  DateTime?
  createdAt DateTime @default(now())
}
